# ============================================================
# ROOT .htaccess — Laravel on cPanel Subdomain
# All requests are routed into public/ — sensitive project
# files and directories are blocked from direct HTTP access.
# ============================================================

# --- Disable directory listing ------------------------------
Options -Indexes

# --- Block access to sensitive root files -------------------
<FilesMatch "^(\.env.*|composer\.(json|lock)|artisan|phpunit\.xml|package(-lock)?\.json|vite\.config\.(ts|js)|tsconfig\.json|CLAUDE\.md|AGENTS\.md|task\.md|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden files and directories (e.g. .git, .env)
    # Allow /.well-known/ for SSL certificate validation
    RewriteCond %{REQUEST_URI} (^|/)\.(?!well-known) [NC]
    RewriteRule ^ - [F,L]

    # Block direct access to sensitive directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # Serve real files that exist inside public/ directly
    # (e.g. public/build/assets/app.js, public/favicon.ico)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Everything else → Laravel front controller
    RewriteRule ^ public/index.php [L]
</IfModule>
